# The API (backend/, Railway). Copy to backend/.env.local for local development: `pnpm dev` loads
# it. Real values live in Railway (one environment each for staging and production) and the shared
# password manager (vault "Pakka Agent", one folder per environment). Never commit a filled-in copy.
# Empty means unset. The frontend's variables are in frontend/.env.example.

# --- API server -----------------------------------------------------------------
# Railway sets PORT. Locally the API listens on 4000 (the frontend uses 3000).
# RAILWAY_ENVIRONMENT_NAME is set by Railway (e.g. staging); it only labels LLM traces, and is unset locally.
PORT=
HOST=                                                     # default 0.0.0.0
# The frontend's address. Browser calls are accepted from it (CORS).
NEXT_PUBLIC_APP_URL=http://localhost:3000                 # staging: https://staging.pakkaagent.in · prod: https://app.pakkaagent.in
# More browser origins allowed to call the API, comma-separated exact origins, never "*".
CORS_ALLOWED_ORIGINS=

# --- Supabase -----------------------------------------------------------------
# Local values come from `pnpm db:status` after `pnpm db:start`
# (API URL, Publishable/anon key, Secret/service_role key).
# The URL and anon key verify the caller's access token and read as that user (row-level security).
# NEXT_PUBLIC_SUPABASE_URL is the project API URL (https://<ref>.supabase.co), never the Postgres
# connection string.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                                # API only, bypasses RLS; never in the frontend

# --- LLM and embeddings -------------------------------------------------------
ANTHROPIC_API_KEY=                                        # REQUIRED. One key per environment; the agent calls Anthropic on every message, so the API will not start without it
EMBEDDINGS_API_KEY=                                       # REQUIRED. MongoDB Atlas model API key (Voyage models); the API will not start without it
# Defaults shown. This is the Atlas endpoint for Voyage models; a Voyage-direct key would need
# https://api.voyageai.com/v1 instead. Must be https (the key is sent to it).
# EMBEDDINGS_BASE_URL=https://ai.mongodb.com/v1
# EMBEDDINGS_MODEL=voyage-4

# --- Meta / WhatsApp Cloud API ------------------------------------------------
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=                                          # verifies webhook signatures, exchanges ES codes
NEXT_PUBLIC_META_ES_CONFIG_ID=                            # Facebook Login for Business configuration id
META_GRAPH_API_VERSION=v26.0                              # pin one version (currently v26.0), upgrade deliberately
PRIVACY_POLICY_URL=                                       # optional; the link in the privacy notice of a contact's first AI reply (default https://pakkaagent.in/privacy)
META_WEBHOOK_VERIFY_TOKEN=                                # the "Verify token" in the Meta app's webhook settings
API_PUBLIC_URL=                                           # this API's https origin, no path; builds the webhook URL clients paste into their own Meta app
META_PARTNER_BUSINESS_ID=                                 # Spark Agent's Business Portfolio ID (digits), shown for partner access
META_SYSTEM_USER_TOKEN=                                   # our own portfolio only: demo number, template admin
WHATSAPP_DEMO_WABA_ID=
WHATSAPP_DEMO_PHONE_NUMBER_ID=
EMBEDDED_SIGNUP_ENABLED=false                             # "true" turns on the Embedded Signup route; keep false until Meta approves the app
WHATSAPP_REGISTER_PIN=                                    # 6-digit two-step PIN used when registering numbers

# --- Google Calendar ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                                      # http://localhost:4000/api/calendar/google/callback (staging: the Railway API origin)

# --- PayU (billing) -------------------------------------------------------------
PAYU_MERCHANT_KEY=                                        # from PayU's dashboard; the test account's outside production
PAYU_MERCHANT_SALT=                                       # secret: Railway only, never the frontend
PAYU_MODE=test                                            # "live" only in production

# --- Inngest ------------------------------------------------------------------
INNGEST_DEV=1                                             # local only: talk to `pnpm inngest:dev`; never on Railway
INNGEST_EVENT_KEY=                                        # staging/prod: from the Inngest dashboard
INNGEST_SIGNING_KEY=
INNGEST_SERVE_ORIGIN=                                     # staging/prod: the API's public origin, e.g. https://api.pakkaagent.in

# --- Email, monitoring, tracing -----------------------------------------------
RESEND_API_KEY=
SENTRY_DSN=
# LLM tracing. Both keys or neither (neither = tracing off, nothing is sent). A trace carries the business id,
# model, prompt version, tokens, estimated cost and time, and NO message text unless LANGFUSE_CAPTURE_TEXT=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com            # https only (the keys are sent to it); default shown, the EU cloud; US: https://us.cloud.langfuse.com
# LANGFUSE_CAPTURE_TEXT=false                             # "true" also sends customers' words and replies, phone numbers and emails masked, cut to 2,000 characters

# --- Crypto -------------------------------------------------------------------
ENCRYPTION_KEY=                                           # AES-256-GCM for tokens at rest: openssl rand -base64 32
