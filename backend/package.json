{
  "name": "@pakka/backend",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conversations": "tsx --env-file-if-exists=.env.local src/conversation-tests/cli.ts",
    "triage:chats": "tsx --env-file-if-exists=.env.local src/conversation-tests/triage-cli.ts",
    "latency:chats": "tsx --env-file-if-exists=.env.local src/conversation-tests/latency-cli.ts",
    "seed:connection": "tsx --env-file-if-exists=.env.local src/scripts/seed-connection.ts",
    "packs:sync": "tsx --env-file-if-exists=.env.local src/scripts/sync-packs.ts",
    "webhook:burst": "tsx --env-file-if-exists=.env.local src/scripts/webhook-burst.ts",
    "cost:per-message": "tsx --env-file-if-exists=.env.local src/scripts/cost-per-message.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@pakka/types": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "htmlparser2": "12.0.0",
    "inngest": "^4.21.1",
    "mammoth": "1.13.0",
    "tsx": "^4.23.15",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pakka/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  }
}
