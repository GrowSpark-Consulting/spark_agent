# Railway Environment Variables Template (Backend API)
# Paste this into Railway: Backend Service -> Variables -> Raw Editor
# Reference: backend/src/lib/env.ts, docs/environments.md

# --- Server & CORS -------------------------------------------------------------
HOST=0.0.0.0
# PORT is assigned automatically by Railway
NEXT_PUBLIC_APP_URL=https://staging.pakkaagent.in
API_PUBLIC_URL=https://api-staging.pakkaagent.in
CORS_ALLOWED_ORIGINS=https://staging.pakkaagent.in,http://localhost:3000

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- AI & Embeddings (Required at boot) ---------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
EMBEDDINGS_API_KEY=<your-voyage-or-atlas-key>
EMBEDDINGS_BASE_URL=https://ai.mongodb.com/v1
EMBEDDINGS_MODEL=voyage-4

# --- Meta / WhatsApp Cloud API ------------------------------------------------
NEXT_PUBLIC_META_APP_ID=<your-meta-app-id>
META_APP_SECRET=<your-meta-app-secret>
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=<your-custom-verify-token>
META_SYSTEM_USER_TOKEN=<your-meta-system-user-token>
WHATSAPP_DEMO_WABA_ID=<your-waba-id>
WHATSAPP_DEMO_PHONE_NUMBER_ID=<your-phone-number-id>

# --- PayU Billing (Sole payment provider; Decision 20) ------------------------
PAYU_MERCHANT_KEY=<your-payu-merchant-key>
PAYU_MERCHANT_SALT=<your-payu-merchant-salt>
PAYU_MODE=test

# --- Google Calendar OAuth -----------------------------------------------------
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<your-api-domain>/api/calendar/google/callback

# --- Inngest (Background Jobs) -------------------------------------------------
INNGEST_EVENT_KEY=<your-inngest-event-key>
INNGEST_SIGNING_KEY=<your-inngest-signing-key>
INNGEST_SERVE_ORIGIN=https://<your-api-domain>

# --- Security & Token Encryption (Required: 32 random bytes base64) -----------
ENCRYPTION_KEY=<generated-via-openssl-rand-base64-32>

# --- Production Monitoring & LLM Tracing (Optional) --------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_TEXT=false
