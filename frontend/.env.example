# The frontend (frontend/, Vercel). Copy to frontend/.env.local for local development (Next.js reads
# env files from the app's own folder, not the repo root). Every NEXT_PUBLIC_* value is compiled into
# the browser bundle, so only public values belong here: server secrets live on the API
# (backend/.env.example). Real values live in Vercel and the shared password manager. Never commit a
# filled-in copy. Empty means unset.

# --- API ------------------------------------------------------------------------
# The API's origin (backend/, Railway), no path. Locally `pnpm dev` runs it on 4000.
NEXT_PUBLIC_API_URL=http://localhost:4000                 # staging/prod: the Railway domain or https://api.pakkaagent.in

# --- Supabase -----------------------------------------------------------------
# Local values come from `pnpm db:status` after `pnpm db:start` (API URL, Publishable/anon key).
# NEXT_PUBLIC_SUPABASE_URL is the project API URL (https://<ref>.supabase.co), never the Postgres
# connection string. Sign-in and /dashboard fail with an error naming the variable if it is anything else.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=                            # the anon / publishable key, limited by RLS
# "Continue with Google" sign-in, read by the Supabase CLI for local Auth (supabase/config.toml,
# [auth.external.google]); the app never reads them. Staging/prod set Google in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# --- Meta (Embedded Signup in the browser) -------------------------------------
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Where "Book a setup call" goes on the assisted connect page (an https address). Optional.
NEXT_PUBLIC_SETUP_CALL_URL=
# The shared WhatsApp number that answers trial/demo codes, digits with country code (e.g. 91XXXXXXXXXX). Optional: unset, the
# wizard says the test chat isn't available. Ask Ops/Raja for the real number; never invent one.
NEXT_PUBLIC_DEMO_WHATSAPP_NUMBER=

# --- Development ----------------------------------------------------------------
# Show the dashboard shell (empty states, no business data) to a signed-in account that has no
# business yet, instead of the "not linked to a business" screen. Always on under `pnpm dev`;
# "true" turns it on for a production build. Never applies on Vercel production.
DEV_DASHBOARD_WITHOUT_TENANT=
